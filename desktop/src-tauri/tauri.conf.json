{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pressdock",
  "version": "0.1.0",
  "identifier": "com.thereadscope.pressdock",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pressdock",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https: http:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost https: http:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "thereadscope",
    "homepage": "https://thereadscope.com/pressdock",
    "shortDescription": "Offline-first desktop manager for WordPress data",
    "category": "Productivity",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBQjMxNjYyMjI1MDg5RUIKUldUcmlWQWlZaGF6eXRpQjBEQlJvTUNxL2YzRlNCeU84Y0lIUHZ5QytZSUZGUnU3WjRnN3hQa3IK",
      "endpoints": ["https://thereadscope.com/pressdock/updates/{{target}}/{{arch}}/{{current_version}}"],
      "windows": { "installMode": "passive" }
    }
  }
}
